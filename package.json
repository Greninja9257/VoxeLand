{
  "name": "voxeland",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VoxeLand - a faithful Minecraft remake in the browser (WebGL2 + TypeScript)",
  "scripts": {
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "railway:build": "npm run fetch-assets && npm run build",
    "start": "node server/index.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.mjs"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
